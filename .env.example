# ---------- DATABASE ----------
# Neon Postgres connection string (production). If missing, the app runs on an
# embedded Postgres (PGlite) stored in ./.data so local preview works with zero setup.
DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

# ---------- ROOMS ----------
# Two rooms are seeded on first boot:
#   live  → the real workspace where this product is being shipped (owner: Amar)
#   demo  → a fictional kickoff so anyone can see the full experience
PROD_PROJECT_CODE=onestop
DEMO_PROJECT_CODE=studio
PRODUCT_NAME=One Stop Pro Manager
OWNER_NAME=Amar Tripathi
OWNER_EMAIL=amar@onestop.pro

# ---------- AUTH ----------
# Secret used to sign session cookies. Any long random string.
AUTH_SECRET=change-me-to-a-long-random-string
# Passcode given to the platform owner (Amar) to unlock full admin/edit access.
ADMIN_PASSCODE=amar-admin
# Emails that are always admin (comma separated) once they sign in.
ADMIN_EMAILS=amar@example.com

# ---------- WHAT YOU ACTUALLY NEED ----------
# Works with nothing else set: both rooms, 30 documents, the board, the tool wall,
# the problem engine, Ask Prime (built-in reasoner) and export all run locally.
# For a real team on Vercel you need exactly two values:
#   1. DATABASE_URL  — a free Neon Postgres database (otherwise the embedded DB
#                      resets whenever the serverless instance restarts)
#   2. AUTH_SECRET   — a long random string so sessions survive deploys
# Everything else below is an upgrade, not a requirement. Live status is at /setup.

# ---------- AI: LOCAL MODELS FIRST (optional, free) ----------
# Run models on your own machine with Ollama. No key, no cost, no data leaving
# the computer. Install https://ollama.com, then:  ollama pull qwen3:4b
# The owner can also switch models inside the app (Owner console → Workspace →
# Local AI); the choice is stored in Postgres, so this env block is optional.
# If neither OLLAMA_* is set, the platform still looks for a server on the
# default port once a model has been chosen in the UI.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Embedding model used to rank documents for Ask Prime (274 MB, optional)
OLLAMA_EMBED_MODEL=nomic-embed-text
# Give slow local models more room (milliseconds). Default 120000.
OLLAMA_TIMEOUT_MS=120000
# Qwen 3 "thinks" before answering; set to on to keep the reasoning trace.
OLLAMA_THINKING=off
# Force one provider when several are configured: ollama|openai|anthropic|gemini|groq|openrouter
# AI_PROVIDER=ollama

# ---------- AI: HOSTED MODELS (optional) ----------
# Any ONE of these also works. Without any provider the app uses the built-in
# local reasoning engine (no network) so the platform is never dead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
