# ---------- DATABASE ----------
# Neon Postgres connection string (production). If missing, the app runs on an
# embedded Postgres (PGlite) stored in ./.data so local preview works with zero setup.
DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require

# ---------- ROOMS ----------
# Two rooms are seeded on first boot:
#   live  → the real workspace where this product is being shipped (owner: Amar)
#   demo  → a fictional kickoff so anyone can see the full experience
PROD_PROJECT_CODE=onestop
DEMO_PROJECT_CODE=studio
PRODUCT_NAME=One Stop Pro Manager
OWNER_NAME=Amar Tripathi
OWNER_EMAIL=amar@onestop.pro

# ---------- AUTH ----------
# Secret used to sign session cookies. Any long random string.
AUTH_SECRET=change-me-to-a-long-random-string
# Passcode given to the platform owner (Amar) to unlock full admin/edit access.
ADMIN_PASSCODE=amar-admin
# Emails that are always admin (comma separated) once they sign in.
ADMIN_EMAILS=amar@example.com

# ---------- AI (optional) ----------
# The copilot works with any ONE of these. Without a key it uses the built-in
# local reasoning engine (no network) so the platform is never dead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
